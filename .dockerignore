# .dockerignore - Exclude unnecessary files from Docker build context

# Dependencies (will be installed fresh in container)
node_modules/

# Build output
.next/

# Data files (will be initialized in container)
data/*.db
data/*.db-wal
data/*.db-shm

# Docker files themselves (keep docker/ for build context)
# docker/

# Git
.git/
.gitignore

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment (will be generated in container)
.env
.env.local
.env.production

# ❗生产密钥（2026-09-01 补）
# 原先只挡了 .env*，漏了下面这三个 —— 它们真的进了 builder 层（实测确认）。
# 这次没出事是因为多阶段构建的 runtime 是独立 stage，builder 层不随镜像分发。
# 但那是运气不是设计：一旦有人改成单阶段、或者把 builder 推到 registry
# 做缓存（--cache-to），生产库密码和 JWT 密钥就直接泄了。
# 密钥一律走运行期环境变量 / 挂载，永远不进构建上下文。
.db_password
.jwt_secret
.env.systemd
*.pem
*.key
secrets*.env

# 本地数据库备份 / 导出（可能含真实业务数据，也没必要进镜像）
*.sql.gz
backups/

# Documentation (not needed in image)
*.md
!workspace/*.md

# Temp files
tmp/
temp/
