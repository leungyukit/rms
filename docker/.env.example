# .env.example - Environment configuration for RMS+OpenClaw Docker
# Copy to .env and modify:  cp .env.example .env

# ===== RMS =====
RMS_PORT=3800

# ===== MySQL =====
MYSQL_PORT=3306
MYSQL_USER=rms
MYSQL_PASSWORD=rms123456
MYSQL_DATABASE=rms

# ===== OpenClaw =====
OPENCLAW_ENABLED=true
OPENCLAW_PORT=18789

# ===== Feishu (飞书) Bot =====
# 填入你的飞书应用凭据，留空则不启用飞书通道
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== Memcached =====
MEMCACHE_PORT=11211
