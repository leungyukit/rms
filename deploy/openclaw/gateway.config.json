{
  "_comment": "Gateway 侧与 RMS 集成相关的非敏感参数。真实 gateway.auth.token 不在本仓库，见 README「敏感项清单」。此文件是参考片段，不能直接当 openclaw.json 用。",
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "<REDACTED — 48 位随机串，生成：openssl rand -hex 24>"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "_comment": "必须开启，RMS 走 /v1/chat/completions",
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "_comment": "全局默认，rms agent 未覆盖时继承这些",
      "workspace": "__HOME__/.openclaw/workspace",
      "model": {
        "primary": "<你的模型 id，例如 volcengine-plan/ark-code-latest>"
      },
      "memorySearch": {
        "_comment": "本地 embedding，无外部 API Key",
        "provider": "ollama",
        "model": "nomic-embed-text"
      }
    }
  }
}
