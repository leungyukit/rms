# RMS Docker 部署环境变量 — 复制为 .env 后填写
# cp .env.example .env

# MySQL（务必改成强密码）
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DATABASE=rms
MYSQL_USER=rms
MYSQL_PASSWORD=CHANGE_ME_rms

# JWT 签名密钥，必须 >=32 位；生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# 对外端口
RMS_PORT=3800

# HTTP 裸端口部署保持 false；上了 HTTPS 改 true
COOKIE_SECURE=false

# OpenClaw Gateway token，必须 >=24 位；生成：openssl rand -hex 32
# entrypoint 会强校验，占位符/弱值直接拒绝启动
GATEWAY_TOKEN=***

# OpenClaw 端口（只绑 127.0.0.1，不暴露公网）
OPENCLAW_PORT=18789

# 模型主选项，留空用镜像内默认
OPENCLAW_MODEL=

# 飞书渠道：两个都填才启用，留空则渠道关闭
FEISHU_APP_ID=
FEISHU_APP_SECRET=
